{
  "name": "@emaarco/bpmn-js-data-simulation",
  "version": "0.2.0",
  "description": "Simulate BPMN processes with data in bpmn-js-token-simulation — scenarios, process variables, io mappings and gateway conditions evaluated in the engine's expression language.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "keywords": [
    "bpmn",
    "bpmn-js",
    "bpmn.io",
    "token-simulation",
    "simulation",
    "process-variables",
    "feel",
    "juel",
    "zeebe",
    "camunda"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/*": "./dist/assets/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:distro": "node test/distro/smoke.mjs",
    "test:consumer": "node test/consumer/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "feelin": "^8.2.0"
  },
  "peerDependencies": {
    "bpmn-js": ">=18",
    "bpmn-js-token-simulation": "1.0.0",
    "diagram-js": ">=15.27"
  },
  "peerDependenciesMeta": {
    "diagram-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/node": "26.6.5",
    "bpmn-js": "18.31.0",
    "bpmn-js-token-simulation": "1.0.0",
    "bpmn-moddle": "10.3.1",
    "camunda-bpmn-moddle": "8.0.2",
    "dependency-cruiser": "18.6.0",
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "rollup": "4.64.10",
    "rollup-plugin-esbuild": "6.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaarco/bpmn-js-data-simulation.git",
    "directory": "packages/bpmn-js-data-simulation"
  },
  "bugs": {
    "url": "https://github.com/emaarco/bpmn-js-data-simulation/issues"
  },
  "homepage": "https://github.com/emaarco/bpmn-js-data-simulation#readme"
}
