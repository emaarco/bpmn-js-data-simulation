<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Order" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Order" name="Order fulfilment" isExecutable="true">
    <bpmn:startEvent id="Start" name="Order received" />
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start" targetRef="Task_CheckCredit" />
    <bpmn:serviceTask id="Task_CheckCredit" name="Check credit rating">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="customerId">${customer.id}</camunda:inputParameter>
          <camunda:outputParameter name="creditScore">${score}</camunda:outputParameter>
          <camunda:outputParameter name="creditworthy">${score ge 600}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCredit" sourceRef="Task_CheckCredit" targetRef="Gateway_Credit" />
    <bpmn:exclusiveGateway id="Gateway_Credit" name="Credit OK?" default="Flow_Rejected" />
    <bpmn:sequenceFlow id="Flow_Approved" name="yes" sourceRef="Gateway_Credit" targetRef="Task_Ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditworthy &amp;&amp; orderTotal &lt;= 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Review" name="large order" sourceRef="Gateway_Credit" targetRef="Task_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditworthy and orderTotal gt 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Gateway_Credit" targetRef="End_Rejected" />
    <bpmn:userTask id="Task_Review" name="Review order" />
    <bpmn:sequenceFlow id="Flow_ToApproved" sourceRef="Task_Review" targetRef="Gateway_Approved" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" />
    <bpmn:sequenceFlow id="Flow_ReviewOk" name="yes" sourceRef="Gateway_Approved" targetRef="Task_Ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewRejected" name="no" sourceRef="Gateway_Approved" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_Ship" name="Ship order" />
    <bpmn:sequenceFlow id="Flow_ToExtras" sourceRef="Task_Ship" targetRef="Gateway_Extras" />
    <bpmn:inclusiveGateway id="Gateway_Extras" name="Extras?" default="Flow_NoExtras" />
    <bpmn:sequenceFlow id="Flow_Insurance" name="insurance" sourceRef="Gateway_Extras" targetRef="Task_Insurance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${insurance}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Accessories" name="accessories" sourceRef="Gateway_Extras" targetRef="Task_Accessories">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty accessories}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoExtras" sourceRef="Gateway_Extras" targetRef="Gateway_Join" />
    <bpmn:serviceTask id="Task_Insurance" name="Add insurance" />
    <bpmn:sequenceFlow id="Flow_InsuranceDone" sourceRef="Task_Insurance" targetRef="Gateway_Join" />
    <bpmn:serviceTask id="Task_Accessories" name="Pack accessories" />
    <bpmn:sequenceFlow id="Flow_AccessoriesDone" sourceRef="Task_Accessories" targetRef="Gateway_Join" />
    <bpmn:inclusiveGateway id="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToShipped" sourceRef="Gateway_Join" targetRef="End_Shipped" />
    <bpmn:endEvent id="End_Shipped" name="Order shipped" />
    <bpmn:endEvent id="End_Rejected" name="Order rejected" />
  </bpmn:process>
</bpmn:definitions>
