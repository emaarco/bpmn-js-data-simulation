<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Return" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Return" name="Return handling" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="startEvent_returnRequested" name="Return requested" camunda:asyncBefore="true">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="startEvent_returnRequested" targetRef="gateway_window" />
    <bpmn:exclusiveGateway id="gateway_window" name="Within return window?" default="flow_late">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:outgoing>flow_inTime</bpmn:outgoing>
      <bpmn:outgoing>flow_late</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_inTime" name="yes" sourceRef="gateway_window" targetRef="userTask_inspect">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${daysSincePurchase le 30}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_late" name="no" sourceRef="gateway_window" targetRef="endEvent_declined" />
    <bpmn:userTask id="userTask_inspect" name="Inspect returned bike" camunda:asyncAfter="true" camunda:assignee="workshop">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="condition">${grade}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_inTime</bpmn:incoming>
      <bpmn:outgoing>flow_toCondition</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_toCondition" sourceRef="userTask_inspect" targetRef="gateway_condition" />
    <bpmn:exclusiveGateway id="gateway_condition" name="Resellable?">
      <bpmn:incoming>flow_toCondition</bpmn:incoming>
      <bpmn:outgoing>flow_refund</bpmn:outgoing>
      <bpmn:outgoing>flow_partial</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_refund" name="full refund" sourceRef="gateway_condition" targetRef="serviceTask_refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">execution.getVariable("condition") === "like new"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_partial" name="partial refund" sourceRef="gateway_condition" targetRef="serviceTask_partial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">execution.getVariable("condition") !== "like new"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="serviceTask_refund" name="Refund full price" camunda:type="external" camunda:topic="refund">
      <bpmn:incoming>flow_refund</bpmn:incoming>
      <bpmn:outgoing>flow_refundDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_refundDone" sourceRef="serviceTask_refund" targetRef="gateway_refunded" />
    <bpmn:serviceTask id="serviceTask_partial" name="Refund minus wear" camunda:type="external" camunda:topic="refundPartial">
      <bpmn:incoming>flow_partial</bpmn:incoming>
      <bpmn:outgoing>flow_partialDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_partialDone" sourceRef="serviceTask_partial" targetRef="gateway_refunded" />
    <bpmn:exclusiveGateway id="gateway_refunded">
      <bpmn:incoming>flow_refundDone</bpmn:incoming>
      <bpmn:incoming>flow_partialDone</bpmn:incoming>
      <bpmn:outgoing>flow_toRefunded</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_toRefunded" sourceRef="gateway_refunded" targetRef="endEvent_refunded" />
    <bpmn:endEvent id="endEvent_refunded" name="Return refunded">
      <bpmn:incoming>flow_toRefunded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEvent_declined" name="Return declined">
      <bpmn:incoming>flow_late</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Return">
      <bpmndi:BPMNShape id="startEvent_returnRequested_di" bpmnElement="startEvent_returnRequested">
        <dc:Bounds x="162" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_window_di" bpmnElement="gateway_window" isMarkerVisible="true">
        <dc:Bounds x="295" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="205" width="140" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="userTask_inspect_di" bpmnElement="userTask_inspect">
        <dc:Bounds x="410" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_condition_di" bpmnElement="gateway_condition" isMarkerVisible="true">
        <dc:Bounds x="575" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="205" width="140" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_refund_di" bpmnElement="serviceTask_refund">
        <dc:Bounds x="690" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_partial_di" bpmnElement="serviceTask_partial">
        <dc:Bounds x="690" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_refunded_di" bpmnElement="endEvent_refunded">
        <dc:Bounds x="972" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_declined_di" bpmnElement="endEvent_declined">
        <dc:Bounds x="442" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_refunded_di" bpmnElement="gateway_refunded" isMarkerVisible="true">
        <dc:Bounds x="855" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="198" y="260" />
        <di:waypoint x="295" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inTime_di" bpmnElement="flow_inTime">
        <di:waypoint x="345" y="260" />
        <di:waypoint x="410" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_late_di" bpmnElement="flow_late">
        <di:waypoint x="320" y="285" />
        <di:waypoint x="320" y="380" />
        <di:waypoint x="442" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toCondition_di" bpmnElement="flow_toCondition">
        <di:waypoint x="510" y="260" />
        <di:waypoint x="575" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refund_di" bpmnElement="flow_refund">
        <di:waypoint x="625" y="260" />
        <di:waypoint x="690" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_partial_di" bpmnElement="flow_partial">
        <di:waypoint x="600" y="285" />
        <di:waypoint x="600" y="380" />
        <di:waypoint x="690" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refundDone_di" bpmnElement="flow_refundDone">
        <di:waypoint x="790" y="260" />
        <di:waypoint x="855" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_partialDone_di" bpmnElement="flow_partialDone">
        <di:waypoint x="790" y="380" />
        <di:waypoint x="880" y="380" />
        <di:waypoint x="880" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_toRefunded_di" bpmnElement="flow_toRefunded">
        <di:waypoint x="905" y="260" />
        <di:waypoint x="972" y="260" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
