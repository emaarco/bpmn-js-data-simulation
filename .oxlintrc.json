{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", ".context/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-namespace": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "max-classes-per-file": ["error", 1]
  },
  "jsPlugins": ["./oxlint-plugins/architecture.mjs"],
  "overrides": [
    {
      "files": ["packages/*/src/**/*.ts"],
      "rules": {
        "architecture/class-first": "error"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "max-classes-per-file": "off"
      }
    }
  ]
}
