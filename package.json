{
  "name": "bpmn-js-data-simulation-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @emaarco/bpmn-js-data-simulation — a data-driven add-on for bpmn-js-token-simulation",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/bpmn-js-data-simulation",
    "packages/example"
  ],
  "scripts": {
    "build": "npm run build -w @emaarco/bpmn-js-data-simulation",
    "dev": "npm run dev -w @emaarco/bpmn-js-data-simulation-example",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @emaarco/bpmn-js-data-simulation-example --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:deps": "npm run lint:deps -w @emaarco/bpmn-js-data-simulation",
    "lint:bpmn": "npm run lint:bpmn:camunda7 && npm run lint:bpmn:camunda7-conditional-flows && npm run lint:bpmn:zeebe",
    "lint:bpmn:camunda7": "bpmnlint --max-warnings=0 --config .bpmnlintrc.camunda7.json \"packages/**/*camunda7.bpmn\"",
    "lint:bpmn:camunda7-conditional-flows": "bpmnlint --max-warnings=0 --config .bpmnlintrc.camunda7-conditional-flows.json \"packages/**/*camunda7-conditional-flows.bpmn\"",
    "lint:bpmn:zeebe": "bpmnlint --max-warnings=0 --config .bpmnlintrc.zeebe.json \"packages/**/*zeebe.bpmn\"",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@miragon/bpmnlint-plugin-rules": "0.24.0",
    "bpmnlint": "12.2.0",
    "knip": "6.45.1",
    "oxlint": "1.93.0",
    "prettier": "3.10.1"
  }
}
